{% comment %}
  Flow Manuals shared design system CSS. Include once per page via
  {% render 'fm-styles' %} — safe to include from multiple sections,
  rules are idempotent (just repeats a small stylesheet).
{% endcomment %}
<style>
  .fm-lp {
    --fm-black: #111111;
    --fm-white: #ffffff;
    --fm-cream: #faf9f6;
    --fm-lime: #b7d34a;
    --fm-lime-dark: #98b83a;
    --fm-gray: #6b6b6b;
    --fm-border: #e7e5df;
    font-family: -apple-system, BlinkMacSystemFont, "Inter", "Helvetica Neue", Arial, sans-serif;
    color: var(--fm-black);
    background: var(--fm-white);
  }
  .fm-lp * { box-sizing: border-box; }
  /* Never let a width/height attribute pair squash an image once the column
     narrows on mobile — always fall back to the file's own aspect ratio. */
  .fm-lp img { max-width: 100%; height: auto; }
  .fm-wrap { max-width: 1100px; margin: 0 auto; padding: 0 24px; }
  .fm-section { padding: 72px 0; }
  .fm-section--tight { padding: 40px 0; }
  .fm-eyebrow {
    display: inline-block; font-size: 12px; font-weight: 700; letter-spacing: .08em;
    text-transform: uppercase; color: var(--fm-lime-dark); margin-bottom: 14px;
  }
  .fm-h1 { font-size: clamp(32px, 5vw, 56px); line-height: 1.08; font-weight: 800; margin: 0 0 20px; letter-spacing: -0.02em; }
  .fm-h2 { font-size: clamp(24px, 3.2vw, 36px); line-height: 1.15; font-weight: 800; margin: 0 0 16px; letter-spacing: -0.01em; }
  .fm-sub { font-size: 18px; line-height: 1.5; color: #333; max-width: 640px; margin: 0 0 28px; }
  .fm-cta {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    background: var(--fm-black); color: var(--fm-white); font-weight: 700; font-size: 15px;
    padding: 16px 30px; border-radius: 8px; text-decoration: none; border: none; cursor: pointer;
    letter-spacing: .02em; transition: transform .15s ease, background .15s ease;
  }
  .fm-cta:hover { background: #000; transform: translateY(-1px); color: var(--fm-white); }
  .fm-cta--lg { padding: 18px 36px; font-size: 16px; }
  .fm-cta-row { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; }
  .fm-trust-mini { font-size: 13px; color: var(--fm-gray); margin-top: 10px; }

  .fm-hero { display: grid; grid-template-columns: 1.1fr 1fr; gap: 56px; align-items: center; }
  @media (max-width: 860px) { .fm-hero { grid-template-columns: 1fr; gap: 32px; } }
  .fm-hero-img { width: 100%; border-radius: 16px; overflow: hidden; background: var(--fm-cream); }
  .fm-hero-img img { width: 100%; height: auto; display: block; }

  .fm-bullets { list-style: none; margin: 32px 0; padding: 0; display: grid; gap: 12px; }
  .fm-bullets li { display: flex; gap: 12px; font-size: 16px; line-height: 1.5; }
  .fm-bullets li::before { content: "✓"; flex: none; font-weight: 800; color: var(--fm-lime-dark); }

  .fm-panel { background: var(--fm-cream); border-radius: 20px; padding: 56px; }
  @media (max-width: 640px) { .fm-panel { padding: 32px 24px; } }

  .fm-symptoms { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 32px; }
  @media (max-width: 760px) { .fm-symptoms { grid-template-columns: 1fr; } }
  .fm-symptom-card { background: var(--fm-white); border: 1px solid var(--fm-border); border-radius: 14px; padding: 24px; }
  .fm-symptom-card h3 { font-size: 17px; font-weight: 700; margin: 0 0 8px; }
  .fm-symptom-card p { font-size: 14px; color: var(--fm-gray); margin: 0; line-height: 1.5; }

  .fm-story { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
  @media (max-width: 860px) { .fm-story { grid-template-columns: 1fr; } }
  .fm-story-img { border-radius: 16px; overflow: hidden; }
  .fm-story-img img { width: 100%; height: auto; display: block; }
  .fm-story.fm-story--reverse .fm-story-img { order: 2; }
  @media (max-width: 860px) { .fm-story.fm-story--reverse .fm-story-img { order: 0; } }

  .fm-modules { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin-top: 32px; }
  @media (max-width: 760px) { .fm-modules { grid-template-columns: 1fr; } }
  .fm-module { border: 1px solid var(--fm-border); border-radius: 14px; padding: 24px; }
  .fm-module .fm-module-num { font-size: 12px; font-weight: 700; color: var(--fm-lime-dark); letter-spacing: .06em; text-transform: uppercase; }
  .fm-module h3 { font-size: 18px; font-weight: 700; margin: 6px 0 8px; }
  .fm-module p { font-size: 14px; color: var(--fm-gray); margin: 0; line-height: 1.5; }

  .fm-pricing { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 32px; }
  @media (max-width: 860px) { .fm-pricing { grid-template-columns: 1fr; } }
  .fm-pricing--single { grid-template-columns: 1fr; max-width: 420px; margin-left: auto; margin-right: auto; }
  .fm-tier {
    position: relative; background: var(--fm-white); border: 1px solid var(--fm-border);
    border-radius: 18px; padding: 32px 26px; display: flex; flex-direction: column; gap: 16px;
  }
  .fm-tier--featured { border: 2px solid var(--fm-black); box-shadow: 0 10px 30px rgba(0,0,0,.08); }
  .fm-tier-badge {
    position: absolute; top: -13px; left: 50%; transform: translateX(-50%);
    background: var(--fm-lime); color: var(--fm-black); font-size: 11px; font-weight: 800;
    letter-spacing: .05em; text-transform: uppercase; padding: 6px 14px; border-radius: 999px;
  }
  .fm-tier h3 { font-size: 18px; font-weight: 800; margin: 0; }
  .fm-tier-price { display: flex; align-items: baseline; gap: 10px; }
  .fm-tier-price .fm-anchor { text-decoration: line-through; color: var(--fm-gray); font-size: 16px; }
  .fm-tier-price .fm-offer { font-size: 30px; font-weight: 800; }
  .fm-tier ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; flex: 1; }
  .fm-tier ul li { font-size: 14px; display: flex; gap: 8px; line-height: 1.4; }
  .fm-tier ul li::before { content: "+"; font-weight: 800; color: var(--fm-lime-dark); }
  .fm-tier .fm-cta { width: 100%; }

  .fm-trust-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 28px; }
  @media (max-width: 760px) { .fm-trust-grid { grid-template-columns: repeat(2, 1fr); } }
  .fm-trust-item { text-align: center; font-size: 13px; font-weight: 600; padding: 18px 10px; border: 1px solid var(--fm-border); border-radius: 12px; }

  .fm-guarantee { display: flex; gap: 28px; align-items: center; background: var(--fm-black); color: var(--fm-white); border-radius: 20px; padding: 44px; }
  @media (max-width: 700px) { .fm-guarantee { flex-direction: column; text-align: center; padding: 32px 24px; } }
  .fm-guarantee-badge {
    flex: none; width: 96px; height: 96px; border-radius: 50%; border: 2px solid var(--fm-lime);
    display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 800;
    text-align: center; color: var(--fm-lime); line-height: 1.2;
  }
  .fm-guarantee h2 { color: var(--fm-white); }
  .fm-guarantee p { color: #d8d8d8; margin: 0; }

  .fm-faq { margin-top: 28px; border-top: 1px solid var(--fm-border); }
  .fm-faq-item { border-bottom: 1px solid var(--fm-border); }
  .fm-faq-item summary {
    cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center;
    padding: 20px 4px; font-weight: 700; font-size: 16px;
  }
  .fm-faq-item summary::-webkit-details-marker { display: none; }
  .fm-faq-item summary::after { content: "+"; font-size: 22px; font-weight: 400; color: var(--fm-gray); }
  .fm-faq-item[open] summary::after { content: "–"; }
  .fm-faq-item p { margin: 0 4px 20px; color: var(--fm-gray); font-size: 15px; line-height: 1.6; }

  .fm-disclaimer { font-size: 12px; color: var(--fm-gray); line-height: 1.6; max-width: 760px; margin: 16px auto 0; text-align: center; }
  .fm-center { text-align: center; }
  .fm-center .fm-sub { margin-left: auto; margin-right: auto; }
  .fm-center .fm-cta-row { justify-content: center; }

  .fm-badge-row { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; margin-top: 18px; }
  .fm-badge {
    display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 700;
    background: var(--fm-cream); border: 1px solid var(--fm-border); border-radius: 999px; padding: 7px 14px;
  }

  /* Desktop padding/gaps between stacked blocks read as generous; on a
     single mobile column they compound (72px + 72px between two sections,
     plus a 56px grid gap that's now a vertical gap) into dead space that
     makes the page feel empty instead of premium. Tighten everything that
     stacks vertically once we're down to one column. */
  @media (max-width: 640px) {
    .fm-section { padding: 40px 0; }
    .fm-section--tight { padding: 24px 0; }
    .fm-hero { gap: 28px; }
    .fm-story { gap: 24px; }
    .fm-h1 { margin-bottom: 14px; }
    .fm-h2 { margin-bottom: 12px; }
    .fm-sub { margin-bottom: 20px; }
    .fm-bullets { margin: 20px 0; gap: 10px; }
    .fm-symptoms, .fm-modules, .fm-pricing, .fm-trust-grid { margin-top: 20px; }
    .fm-panel { padding: 28px 20px; }
    .fm-guarantee { padding: 28px 22px; gap: 18px; }
    .fm-faq { margin-top: 18px; }
  }
</style>
