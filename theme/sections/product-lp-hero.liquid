{% comment %}
  Product page hero copy block — the punchy LP-style intro that sits above
  Shopify's native main-product section (which handles the real buy box).
{% endcomment %}
<div class="fm-lp">
  {% render 'fm-styles' %}
  {% render 'fm-buy-now' %}
  {% assign fm_variant_id = section.settings.variant_id %}
  {% assign fm_cart_link = '/cart/' | append: fm_variant_id | append: ':1' %}
  <div class="fm-section fm-section--tight">
    <div class="fm-wrap fm-center" style="max-width:760px;margin:0 auto;">
      <span class="fm-eyebrow">{{ section.settings.eyebrow | default: "For sales teams tired of sounding like everyone else" }}</span>
      <h1 class="fm-h1">{{ section.settings.headline | default: "Sell Better Than The Algorithm." }}</h1>
      <p class="fm-sub" style="margin-left:auto;margin-right:auto;">{{ section.settings.subheadline | default: "In an age of AI-written pitches that all sound the same, the edge belongs to people who master real, human persuasion. This is the restored Stratton Oakmont training manual." }}</p>
      <div class="fm-cta-row">
        <a href="{{ fm_cart_link }}" data-variant-id="{{ fm_variant_id }}" class="fm-cta fm-cta--lg fm-buy-now">{{ section.settings.cta_text | default: "Get The Manual Now" }}</a>
      </div>
      <div class="fm-badge-row">
        <span class="fm-badge">Instant digital download</span>
        <span class="fm-badge">One-time payment</span>
        <span class="fm-badge">30-day guarantee</span>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "LP hero copy",
  "settings": [
    { "type": "text", "id": "variant_id", "label": "Variant ID for buy button", "info": "Numeric Shopify variant ID, e.g. 54043984626002" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "headline", "label": "Headline" },
    { "type": "textarea", "id": "subheadline", "label": "Subheadline" },
    { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Get The Manual Now" }
  ],
  "presets": [{ "name": "LP hero copy" }]
}
{% endschema %}
