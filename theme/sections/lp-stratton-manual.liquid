{% comment %}
  Flow Manuals — one-page sales funnel for the Stratton Oakmont training manual.
  Drop this section into a dedicated page template (see templates/page.flow-manual-lp.json)
  so the homepage/product page stays free of nav distractions.
{% endcomment %}

<div class="fm-lp" id="shopify-section-{{ section.id }}">
  {% render 'fm-styles' %}
  {% render 'fm-buy-now' %}
  {% assign fm_variant_id = section.settings.variant_id %}
  {% assign fm_cart_link = '/cart/' | append: fm_variant_id | append: ':1' %}

  {% comment %} ============ HERO ============ {% endcomment %}
  <div class="fm-section">
    <div class="fm-wrap fm-hero">
      <div>
        <span class="fm-eyebrow">{{ section.settings.eyebrow | default: "For sales teams tired of sounding like everyone else" }}</span>
        <h1 class="fm-h1">{{ section.settings.headline | default: "Sell Better Than The Algorithm." }}</h1>
        <p class="fm-sub">{{ section.settings.subheadline | default: "In an age of AI-written pitches that all sound the same, the edge belongs to people who master real, human persuasion. This is the restored Stratton Oakmont training manual — the sales training that became a legend." }}</p>
        <div class="fm-cta-row">
          <a href="{{ fm_cart_link }}" data-variant-id="{{ fm_variant_id }}" class="fm-cta fm-cta--lg fm-buy-now">{{ section.settings.cta_text | default: "Get The Manual Now" }}</a>
        </div>
        <p class="fm-trust-mini">Instant digital download · One-time payment · 30-day guarantee</p>
      </div>
      <div class="fm-hero-img">
        {% if section.settings.hero_image %}
          <img src="{{ section.settings.hero_image | image_url: width: 900 }}" alt="{{ section.settings.headline | escape }}" loading="eager" width="900" height="{{ 900 | divided_by: section.settings.hero_image.aspect_ratio }}">
        {% else %}
          <img src="{{ 'flow-manual-hero-placeholder.png' | asset_url }}" alt="Flow Manuals" loading="eager">
        {% endif %}
      </div>
    </div>
  </div>

  {% comment %} ============ BULLET STACK ============ {% endcomment %}
  <div class="fm-section fm-section--tight">
    <div class="fm-wrap">
      <ul class="fm-bullets">
        {% for block in section.blocks %}
          {% if block.type == "bullet" %}
            <li{{ block.shopify_attributes }}>{{ block.settings.text }}</li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>
  </div>

  {% comment %} ============ PATTERN INTERRUPT ============ {% endcomment %}
  <div class="fm-section">
    <div class="fm-wrap fm-panel fm-center">
      <span class="fm-eyebrow">Attention</span>
      <h2 class="fm-h2">{{ section.settings.interrupt_headline | default: 'If "let me think about it" has ever ended a sale you should have closed — this is for you.' }}</h2>
      <p class="fm-sub" style="margin-left:auto;margin-right:auto;">{{ section.settings.interrupt_body | default: "Closing was never about charisma. It's about sequence — the right thing, in the right order, at the right moment. Most people never learn the sequence, so they wing it and lose deals they should have won." }}</p>
    </div>
  </div>

  {% comment %} ============ ABOUT THE DOCUMENT ============ {% endcomment %}
  <div class="fm-section">
    <div class="fm-wrap fm-story">
      <div>
        <h2 class="fm-h2">{{ section.settings.about_headline | default: "Why This Manual Still Works Today" }}</h2>
        <p class="fm-sub">{{ section.settings.about_body | default: "Before compliance scripts and AI-written pitches, Stratton Oakmont trained an entire floor of brokers to run the same tight, repeatable process on every single call. Whatever you think of the firm's history, the training itself is one of the most studied — and most copied — sales systems ever put on paper. We tracked it down, restored it, and digitized it page for page." }}</p>
        <a href="{{ section.settings.cta_link | default: '#pricing' }}" class="fm-cta">Read The Original Pages</a>
      </div>
      <div class="fm-story-img">
        {% if section.settings.about_image %}
          <img src="{{ section.settings.about_image | image_url: width: 700 }}" alt="Original manual page" loading="lazy" width="700" height="{{ 700 | divided_by: section.settings.about_image.aspect_ratio }}">
        {% else %}
          <img src="{{ 'flow-manual-page-placeholder.png' | asset_url }}" alt="Original manual page" loading="lazy">
        {% endif %}
      </div>
    </div>
  </div>

  {% comment %} ============ PROBLEM AGITATION / SYMPTOMS ============ {% endcomment %}
  <div class="fm-section">
    <div class="fm-wrap">
      <div class="fm-center" style="max-width:700px;margin:0 auto;">
        <h2 class="fm-h2">{{ section.settings.problem_headline | default: "Most People Who Struggle To Sell Have One Invisible Problem: Conversation Drift" }}</h2>
      </div>
      <div class="fm-symptoms">
        {% for block in section.blocks %}
          {% if block.type == "symptom" %}
            <div class="fm-symptom-card"{{ block.shopify_attributes }}>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.body }}</p>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  {% comment %} ============ MECHANISM REVEAL ============ {% endcomment %}
  <div class="fm-section">
    <div class="fm-wrap fm-story fm-story--reverse">
      <div>
        <h2 class="fm-h2">{{ section.settings.mechanism_headline | default: "The Straight Line — One Structure, Every Call" }}</h2>
        <p class="fm-sub">{{ section.settings.mechanism_body | default: "One repeatable structure that carries a conversation from open to close, so you run the same winning process every time — instead of reinventing it and hoping." }}</p>
      </div>
      <div class="fm-story-img">
        {% if section.settings.mechanism_image %}
          <img src="{{ section.settings.mechanism_image | image_url: width: 700 }}" alt="The Straight Line method" loading="lazy" width="700" height="{{ 700 | divided_by: section.settings.mechanism_image.aspect_ratio }}">
        {% else %}
          <img src="{{ 'flow-manual-notebook-placeholder.png' | asset_url }}" alt="The Straight Line method" loading="lazy">
        {% endif %}
      </div>
    </div>
  </div>

  {% comment %} ============ WHAT'S INSIDE ============ {% endcomment %}
  <div class="fm-section">
    <div class="fm-wrap">
      <div class="fm-center" style="max-width:700px;margin:0 auto;">
        <span class="fm-eyebrow">What's inside</span>
        <h2 class="fm-h2">{{ section.settings.modules_headline | default: "Here's Exactly What's Inside" }}</h2>
      </div>
      <div class="fm-modules">
        {% for block in section.blocks %}
          {% if block.type == "module" %}
            <div class="fm-module"{{ block.shopify_attributes }}>
              <span class="fm-module-num">{{ block.settings.number | default: "Module" }}</span>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.body }}</p>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  {% comment %} ============ PRICING ============ {% endcomment %}
  <div class="fm-section" id="pricing">
    <div class="fm-wrap">
      <div class="fm-center" style="max-width:700px;margin:0 auto;">
        <h2 class="fm-h2">{{ section.settings.pricing_headline | default: "Pick Your Package" }}</h2>
        <p class="fm-sub" style="margin-left:auto;margin-right:auto;">{{ section.settings.pricing_subheadline | default: "One-time payment. No subscription, ever." }}</p>
      </div>
      {% assign tier_count = 0 %}
      {% for block in section.blocks %}
        {% if block.type == "tier" %}{% assign tier_count = tier_count | plus: 1 %}{% endif %}
      {% endfor %}
      <div class="fm-pricing{% if tier_count == 1 %} fm-pricing--single{% endif %}">
        {% for block in section.blocks %}
          {% if block.type == "tier" %}
            <div class="fm-tier{% if block.settings.featured %} fm-tier--featured{% endif %}"{{ block.shopify_attributes }}>
              {% if block.settings.featured %}<span class="fm-tier-badge">Most Popular</span>{% endif %}
              <h3>{{ block.settings.title }}</h3>
              <div class="fm-tier-price">
                {% if block.settings.anchor_price != blank %}<span class="fm-anchor">{{ block.settings.anchor_price }}</span>{% endif %}
                <span class="fm-offer">{{ block.settings.offer_price }}</span>
              </div>
              <ul>
                {% assign items = block.settings.features | newline_to_br | split: '<br />' %}
                {% for item in items %}
                  {% if item != blank %}<li>{{ item | strip }}</li>{% endif %}
                {% endfor %}
              </ul>
              {% assign tier_variant_id = block.settings.variant_id | default: fm_variant_id %}
              <a href="{{ block.settings.buy_link | default: fm_cart_link }}" data-variant-id="{{ tier_variant_id }}" class="fm-cta fm-buy-now">{{ block.settings.cta_text | default: "Get This Package" }}</a>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  {% comment %} ============ TRUST BLOCK ============ {% endcomment %}
  <div class="fm-section fm-section--tight">
    <div class="fm-wrap">
      <div class="fm-trust-grid">
        <div class="fm-trust-item">Instant Digital Access</div>
        <div class="fm-trust-item">Secure Checkout</div>
        <div class="fm-trust-item">One-Time Payment</div>
        <div class="fm-trust-item">30-Day Guarantee</div>
      </div>
    </div>
  </div>

  {% comment %} ============ GUARANTEE ============ {% endcomment %}
  <div class="fm-section">
    <div class="fm-wrap">
      <div class="fm-guarantee">
        <div class="fm-guarantee-badge">30 Day<br>Guarantee</div>
        <div>
          <h2 class="fm-h2">{{ section.settings.guarantee_headline | default: 'The "Read It, Use It, Or Get It Back" Guarantee' }}</h2>
          <p>{{ section.settings.guarantee_body | default: "Read the manual. Use one technique in one real conversation within 30 days. If it doesn't help, email us for a full refund — no forms, no hoops." }}</p>
        </div>
      </div>
    </div>
  </div>

  {% comment %} ============ FAQ ============ {% endcomment %}
  <div class="fm-section">
    <div class="fm-wrap" style="max-width:800px;">
      <div class="fm-center">
        <h2 class="fm-h2">Frequently Asked Questions</h2>
      </div>
      <div class="fm-faq">
        {% for block in section.blocks %}
          {% if block.type == "faq_item" %}
            <details class="fm-faq-item"{{ block.shopify_attributes }}>
              <summary>{{ block.settings.question }}</summary>
              <p>{{ block.settings.answer }}</p>
            </details>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  {% comment %} ============ FINAL CTA ============ {% endcomment %}
  <div class="fm-section">
    <div class="fm-wrap fm-center">
      <h2 class="fm-h2">{{ section.settings.final_headline | default: "Every Great Sales Floor Ran On A Manual." }}</h2>
      <p class="fm-sub" style="margin-left:auto;margin-right:auto;">{{ section.settings.final_body | default: "Not on talent, not on motivation — on a documented system, drilled until it was second nature. That system is restored, page for page, and ready to download. The next call you take could be the first one you run with it." }}</p>
      <div class="fm-cta-row">
        <a href="{{ fm_cart_link }}" data-variant-id="{{ fm_variant_id }}" class="fm-cta fm-cta--lg fm-buy-now">{{ section.settings.cta_text | default: "Get The Manual Now" }}</a>
      </div>
      <p class="fm-disclaimer">{{ section.settings.disclaimer | default: "Flow Manuals is an independent publisher of historical sales-training material. This product is a restored digital copy of a training document from Stratton Oakmont, Inc. It is not affiliated with, endorsed by, or sponsored by Jordan Belfort or any successor entity, and is offered for educational and historical reference. Results depend on individual effort and application; this product does not guarantee specific sales outcomes." }}</p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Flow Manual — LP",
  "settings": [
    { "type": "header", "content": "Buy button" },
    { "type": "text", "id": "variant_id", "label": "Default variant ID for all buy buttons", "info": "Numeric Shopify variant ID, e.g. 54043984626002" },

    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "headline", "label": "Headline" },
    { "type": "textarea", "id": "subheadline", "label": "Subheadline" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    { "type": "url", "id": "cta_link", "label": "Primary CTA link" },
    { "type": "text", "id": "cta_text", "label": "Primary CTA text", "default": "Get The Manual Now" },

    { "type": "header", "content": "Pattern interrupt" },
    { "type": "text", "id": "interrupt_headline", "label": "Headline" },
    { "type": "textarea", "id": "interrupt_body", "label": "Body" },

    { "type": "header", "content": "About the document" },
    { "type": "text", "id": "about_headline", "label": "Headline" },
    { "type": "textarea", "id": "about_body", "label": "Body" },
    { "type": "image_picker", "id": "about_image", "label": "Image" },

    { "type": "header", "content": "Problem agitation" },
    { "type": "text", "id": "problem_headline", "label": "Headline" },

    { "type": "header", "content": "Mechanism" },
    { "type": "text", "id": "mechanism_headline", "label": "Headline" },
    { "type": "textarea", "id": "mechanism_body", "label": "Body" },
    { "type": "image_picker", "id": "mechanism_image", "label": "Image" },

    { "type": "header", "content": "What's inside" },
    { "type": "text", "id": "modules_headline", "label": "Headline" },

    { "type": "header", "content": "Pricing" },
    { "type": "text", "id": "pricing_headline", "label": "Headline" },
    { "type": "textarea", "id": "pricing_subheadline", "label": "Subheadline" },

    { "type": "header", "content": "Guarantee" },
    { "type": "text", "id": "guarantee_headline", "label": "Headline" },
    { "type": "textarea", "id": "guarantee_body", "label": "Body" },

    { "type": "header", "content": "Final CTA" },
    { "type": "text", "id": "final_headline", "label": "Headline" },
    { "type": "textarea", "id": "final_body", "label": "Body" },
    { "type": "textarea", "id": "disclaimer", "label": "Legal disclaimer" }
  ],
  "blocks": [
    {
      "type": "bullet",
      "name": "Bullet",
      "settings": [{ "type": "text", "id": "text", "label": "Bullet text" }]
    },
    {
      "type": "symptom",
      "name": "Symptom card",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "body", "label": "Body" }
      ]
    },
    {
      "type": "module",
      "name": "Module",
      "settings": [
        { "type": "text", "id": "number", "label": "Label (e.g. Module 1)" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "body", "label": "Body" }
      ]
    },
    {
      "type": "tier",
      "name": "Pricing tier",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "anchor_price", "label": "Anchor (crossed-out) price" },
        { "type": "text", "id": "offer_price", "label": "Offer price" },
        { "type": "checkbox", "id": "featured", "label": "Highlight as most popular" },
        { "type": "textarea", "id": "features", "label": "Features (one per line)" },
        { "type": "url", "id": "buy_link", "label": "Buy link override (optional, falls back to cart permalink)" },
        { "type": "text", "id": "variant_id", "label": "Variant ID override (optional, falls back to section default)" },
        { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Get This Package" }
      ]
    },
    {
      "type": "faq_item",
      "name": "FAQ item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "textarea", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Flow Manual — LP",
      "blocks": [
        { "type": "bullet", "settings": { "text": "A field-tested closing framework, not recycled theory from a business degree" } },
        { "type": "bullet", "settings": { "text": "Turns objections into buying signals instead of dead ends" } },
        { "type": "bullet", "settings": { "text": "Works for calls, DMs, and in-person — cold or warm, one flow" } },
        { "type": "bullet", "settings": { "text": "Kills the awkward \"trying to sell\" feeling so conversations feel natural again" } },
        { "type": "bullet", "settings": { "text": "Restored from real trading-floor training, not a corporate script" } },
        { "type": "bullet", "settings": { "text": "30-day guarantee — read it, use it, or get your money back" } },

        { "type": "symptom", "settings": { "title": "You lose control of the conversation", "body": "The prospect steers, you react, and by the time you try to close, the moment's gone." } },
        { "type": "symptom", "settings": { "title": "You over-explain instead of asking", "body": "You talk more when you're nervous, which buries your offer under noise." } },
        { "type": "symptom", "settings": { "title": "You freeze on objections", "body": "\"I need to think about it\" ends the call instead of opening the real conversation." } },

        { "type": "module", "settings": { "number": "Module 1", "title": "The Qualifying Call", "body": "The word-for-word opening used to qualify a prospect and set the frame in under 60 seconds." } },
        { "type": "module", "settings": { "number": "Module 2", "title": "The Objection Rebuttal Library", "body": "Scripted responses to money, timing, \"I need to think about it,\" and the brush-off." } },
        { "type": "module", "settings": { "number": "Module 3", "title": "The Closing Sequence", "body": "How the floor moved a qualified prospect from interest to a firm yes." } },
        { "type": "module", "settings": { "number": "Module 4", "title": "Certification & Training Notes", "body": "The internal notes new hires were actually drilled on before taking live calls." } },

        { "type": "tier", "settings": { "title": "The Manual", "anchor_price": "€39,99", "offer_price": "€17,52", "featured": false, "features": "Full restored PDF\nInstant download\nLifetime access", "cta_text": "Get The Manual" } },
        { "type": "tier", "settings": { "title": "Manual + Rebuttal Swipe File", "anchor_price": "€54,99", "offer_price": "€24,52", "featured": true, "features": "Everything in The Manual\nPrintable objection swipe file\nInstant download", "cta_text": "Get This Package" } },
        { "type": "tier", "settings": { "title": "Manual + Swipe File + Audio", "anchor_price": "€74,99", "offer_price": "€34,52", "featured": false, "features": "Everything above\nFull audio read-through\nListen anywhere", "cta_text": "Get The Full Stack" } },

        { "type": "faq_item", "settings": { "question": "Is this really the original manual?", "answer": "It's a restored, cleaned-up digital copy sourced from an original training document. Pages are presented as-is, for historical and educational reference." } },
        { "type": "faq_item", "settings": { "question": "Can't I just find a free scan online?", "answer": "You might find low-quality, incomplete scans. Ours is cleaned up, fully legible, and organized so you can actually study and use it." } },
        { "type": "faq_item", "settings": { "question": "It's from the 1990s. Isn't it outdated?", "answer": "The channels have changed — calls, DMs, video. The underlying structure of how people move from curious to committed hasn't." } },
        { "type": "faq_item", "settings": { "question": "Will it work in my industry?", "answer": "The sequence is industry-agnostic: qualify, handle the real objection, close. You adapt the words, not the structure." } },
        { "type": "faq_item", "settings": { "question": "I don't do cold calls. Is this still relevant?", "answer": "Yes — the same objection-handling and closing sequence applies to DMs, discovery calls, and in-person conversations." } },
        { "type": "faq_item", "settings": { "question": "How do I get it, and in what format?", "answer": "Instant digital delivery as a PDF by email right after checkout. Readable on phone, tablet, or computer." } },
        { "type": "faq_item", "settings": { "question": "Is this a get-rich-quick program?", "answer": "No. It's a sales-training document. Results depend on your own effort and how you apply it — we don't promise specific income or outcomes." } }
      ]
    }
  ]
}
{% endschema %}
