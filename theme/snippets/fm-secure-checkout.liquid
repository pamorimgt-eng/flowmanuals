{% comment %}
  Secure-checkout badge row (lock label + payment method icons).
  Include under any buy button via {% render 'fm-secure-checkout' %}.
{% endcomment %}
<style>
  .flow-pay-secure{
    display:flex;align-items:center;justify-content:center;gap:7px;
    font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;
    font-weight:600;font-size:14px;color:#17191C;margin:14px 0 10px;
  }
  .flow-pay-secure svg{width:15px;height:15px;color:#9EC24D;flex:none}
  .flow-pay-list{
    display:flex;flex-wrap:wrap;justify-content:center;align-items:center;
    gap:8px;list-style:none;margin:0;padding:0;
  }
  .flow-pay-list .icon-svg{height:32px;width:auto;border-radius:5px;display:block}
</style>

<div class="flow-pay-secure">
  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <rect x="4.5" y="10.5" width="15" height="10" rx="2" fill="currentColor"/>
    <path d="M7.5 10.5V8a4.5 4.5 0 019 0v2.5" stroke="currentColor" stroke-width="2"/>
  </svg>
  <span>Secure Checkout</span>
</div>

<ul class="flow-pay-list" role="list">
  {% assign payment_types = 'visa,master,american_express,maestro,discover,paypal,apple_pay,google_pay,shopify_pay' | split: ',' %}
  {% for type in payment_types %}
    <li>{{ type | payment_type_svg_tag: class: 'icon-svg' }}</li>
  {% endfor %}
</ul>
